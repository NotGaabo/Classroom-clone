{
  "info": {
    "_postman_id": "f57b5388-63da-4a71-9cb7-fc01423b8c62",
    "name": "classroom-clone api smoke",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Create Class",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "{{cookieHeader}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman QA {{$timestamp}}\",\n  \"description\": \"API smoke generado por Newman\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/classes",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "classes"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Create class returns 201', function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "const payload = pm.response.json();",
              "pm.environment.set('apiClassId', payload.data.id);",
              "pm.environment.set('apiClassName', payload.data.name);"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "List Classes",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Cookie",
            "value": "{{cookieHeader}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/classes",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "classes"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('List classes returns 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const payload = pm.response.json();",
              "const names = (payload.data || []).map((item) => item.name);",
              "pm.test('Created class is returned in the listing', function () {",
              "  pm.expect(names).to.include(pm.environment.get('apiClassName'));",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Create Assignment",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "{{cookieHeader}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"class_id\": \"{{apiClassId}}\",\n  \"title\": \"Postman Assignment {{$timestamp}}\",\n  \"description\": \"Asignación creada por la colección de Newman\",\n  \"points\": 20,\n  \"due_date\": null\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/assignments",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "assignments"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Create assignment returns 201', function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "const payload = pm.response.json();",
              "pm.environment.set('apiAssignmentId', payload.data.id);",
              "pm.environment.set('apiAssignmentTitle', payload.data.title);"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "List Assignments",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Cookie",
            "value": "{{cookieHeader}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/assignments?class_id={{apiClassId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "assignments"
          ],
          "query": [
            {
              "key": "class_id",
              "value": "{{apiClassId}}"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('List assignments returns 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const payload = pm.response.json();",
              "const titles = (payload.data || []).map((item) => item.title);",
              "pm.test('Created assignment is returned in the listing', function () {",
              "  pm.expect(titles).to.include(pm.environment.get('apiAssignmentTitle'));",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "List Comments",
      "request": {
        "method": "GET",
