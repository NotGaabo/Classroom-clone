            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "{{cookieHeader}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"content\": \"Comentario API {{$timestamp}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/assignments/{{apiAssignmentId}}/comments",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "assignments",
            "{{apiAssignmentId}}",
            "comments"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Create comment returns 201', function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "const payload = pm.response.json();",
              "pm.test('Create comment returns a comment id', function () {",
